# =====================================================================
#  DomusApp · variables de entorno (copiar a .env y cambiar TODOS los secretos)
# =====================================================================

# ---------------------------------------------------------------- General
# La hora del servidor va en UTC; cada condominio tiene su propia zona horaria (fase 1)
TZ=UTC
NODE_ENV=production
APP_ENVIRONMENT=dev
APP_VERSION=0.1.0
# Puerto del panel administrativo (y del proxy /api que usa la app móvil)
WEB_PORT=8090

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=domusapp
POSTGRES_USER=domus_owner
POSTGRES_PASSWORD=cambiar-owner-123
# Rol de la aplicación: sólo DML (SELECT/INSERT/UPDATE/DELETE + EXECUTE), sin DDL ni BYPASSRLS
APP_DB_USER=domus_app
APP_DB_PASSWORD=cambiar-app-123

# ---------------------------------------------------------------- Seguridad / sesión
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambiar-por-64-hex-cambiar-por-64-hex-cambiar
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
# App móvil: la sesión dura días (refresh en el almacenamiento seguro del teléfono)
MOBILE_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Intentos de login/OTP por IP cada 15 min (frena el rociado de contraseñas)
AUTH_RATE_LIMIT=60
PASSWORD_HISTORY=5
# true detrás de HTTPS; false sólo en localhost
COOKIE_SECURE=false

# ---------------------------------------------------------------- Correo (mailpit en desarrollo)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=DomusApp <no-reply@domusapp.local>
APP_PUBLIC_URL=http://localhost:8090
MAILPIT_UI_PORT=8026

# Archivos subidos (fotos de incidentes, comprobantes, contratos): tamaño máximo, en MB
UPLOAD_MAX_MB=8

# Notificaciones push (Expo). Apagado en desarrollo: la app recibe todo por la campana y el socket.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------- Administrador de plataforma inicial
ADMIN_EMAIL=admin@domusapp.local
ADMIN_INITIAL_PASSWORD=cambiar-Admin-2026

# ---------------------------------------------------------------- Demostración (solo dev/qa)
# Crea "Residencial Las Palmas" y "Oficentro Plaza Norte" con usuarios de prueba (ver README)
SEED_DEMO=true
DEMO_PASSWORD=Demo-Domus-2026

# ---------------------------------------------------------------- pgAdmin (perfil tools)
PGADMIN_EMAIL=admin@domusapp.local
PGADMIN_PASSWORD=cambiar-pgadmin
PGADMIN_PORT=5051
