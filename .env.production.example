# =====================================================================
#  DomusApp · variables de PUBLICACIÓN (qa o prod)
#  cp .env.production.example .env.production   y reemplazar TODO lo marcado con «CAMBIAR».
#  Los secretos se generan en el servidor con:   openssl rand -hex 32
#  El archivo real (.env.production) NUNCA va al repositorio (.gitignore).
#  La API no arranca si queda un valor de desarrollo (cookie sin HTTPS, secretos del ejemplo, mailpit…).
# =====================================================================

# ---------------------------------------------------------------- Ambiente
# qa   → servidor de pruebas (rama qa), puede tener datos de demostración
# prod → producción (rama main), sin datos de demostración ni pasarela simulada
APP_ENVIRONMENT=CAMBIAR-qa-o-prod
APP_VERSION=1.0.0

# ---------------------------------------------------------------- Publicación
# Sin dominio propio: <ip-con-guiones>.sslip.io resuelve a la IP (p. ej. 203-0-113-10.sslip.io).
# Con dominio: qa.domusapp.com / app.domusapp.com (registro A hacia la IP del servidor).
DOMAIN=CAMBIAR.sslip.io
APP_PUBLIC_URL=https://CAMBIAR.sslip.io
# Correo para el aviso de vencimiento del certificado (Let's Encrypt)
ACME_EMAIL=CAMBIAR@correo.com
# Contacto que aparece en la política de privacidad (https://<dominio>/privacidad)
SUPPORT_EMAIL=CAMBIAR@correo.com

# ---------------------------------------------------------------- General
# La hora del servidor va en UTC; cada condominio tiene su propia zona horaria
TZ=UTC
NODE_ENV=production
# No se publica (Caddy usa la red interna); el compose base lo exige.
WEB_PORT=8090

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=domusapp
POSTGRES_USER=domus_owner
POSTGRES_PASSWORD=CAMBIAR-openssl-rand-hex-32
APP_DB_USER=domus_app
APP_DB_PASSWORD=CAMBIAR-openssl-rand-hex-32

# ---------------------------------------------------------------- Seguridad / sesión
JWT_ACCESS_SECRET=CAMBIAR-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
MOBILE_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=30
PASSWORD_HISTORY=5
# Obligatorio con HTTPS: la cookie de sesión solo viaja cifrada
COOKIE_SECURE=true

# ---------------------------------------------------------------- Correo real (OTP, invitaciones, avisos)
# Gmail: smtp.gmail.com:587 con una contraseña de aplicación (SMTP_FROM = la misma cuenta).
# Brevo: smtp-relay.brevo.com:587 con el usuario y la clave SMTP (remitente verificado).
SMTP_HOST=CAMBIAR-smtp.proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR
SMTP_PASSWORD=CAMBIAR
SMTP_FROM=DomusApp <CAMBIAR@correo.com>
# No se usa (mailpit no se levanta); el compose base lo exige.
MAILPIT_UI_PORT=8026

UPLOAD_MAX_MB=8

# ---------------------------------------------------------------- Notificaciones push (Expo)
# true para que lleguen al teléfono con la app cerrada. El token es opcional (Expo → Access tokens);
# si lo crea, active "Enhanced security for push notifications" en el proyecto de expo.dev.
EXPO_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------- Pagos con tarjeta
# none      → la app no ofrece el pago con tarjeta (los residentes reportan transferencias).
# simulated → tarjetas de prueba (SOLO qa; en prod la API no arranca con esto).
PAYMENT_GATEWAY=none
PAYMENT_WEBHOOK_SECRET=CAMBIAR-openssl-rand-hex-32

# ---------------------------------------------------------------- Administrador de plataforma inicial
# Un correo REAL: ahí llega el código OTP del primer ingreso.
ADMIN_EMAIL=CAMBIAR@correo.com
# Temporal: el sistema obliga a cambiarla al entrar
ADMIN_INITIAL_PASSWORD=CAMBIAR-Temporal.2026

# ---------------------------------------------------------------- Demostración (solo qa)
# En qa puede ser true para probar con "Residencial Las Palmas"; en prod la API exige false.
# Si la activa, ponga una contraseña propia en DEMO_PASSWORD: la del README es pública y la API no la acepta fuera de dev.
SEED_DEMO=false
# DEMO_PASSWORD=

# ---------------------------------------------------------------- pgAdmin (no se levanta: perfil tools)
PGADMIN_EMAIL=admin@localhost.local
PGADMIN_PASSWORD=CAMBIAR
PGADMIN_PORT=5051
